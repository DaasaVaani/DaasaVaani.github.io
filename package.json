{
  "name": "@daasavaani/website", "version": "0.1.0", "private": true, "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "vite", "build": "tsc --noEmit && vite build", "preview": "vite preview",
    "test": "vitest run", "test:e2e": "playwright test",
    "demo:publish": "node tools/prepare-demo.mjs",
    "icons": "node --experimental-strip-types tools/generate-app-icons.ts",
    "demo": "npm run demo:publish && vite --host=127.0.0.1 --strictPort",
    "check": "npm test && npm run test:e2e"
  },
  "dependencies": {
    "react": "19.3.0", "react-dom": "19.3.0", "react-router-dom": "7.18.4",
    "dexie": "4.4.6", "ajv": "8.20.0", "yaml": "2.9.1", "pako": "3.0.2"
  },
  "devDependencies": {
    "@types/react": "19.3.0", "@types/react-dom": "19.3.0", "@types/node": "22.20.4",
    "@vitejs/plugin-react": "6.1.2", "vite": "8.3.4", "typescript": "5.9.3",
    "vitest": "5.0.4", "@playwright/test": "1.64.0", "workbox-build": "7.4.1"
  }
}
