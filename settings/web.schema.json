{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["formatVersion", "base", "descriptorUrl", "lyricPreview", "canonicalBaseUrl", "listLinkPath", "listFileName", "backupFileName", "transferChunkBytes", "listCompressionLevel", "demoPort", "appShell", "databaseName", "fontFamily", "readerFontSize", "readerFontSizeMin", "readerFontSizeMax", "readerFontSizeStep", "readerLineHeights", "space", "contentWidth", "readerWidth", "themes", "demoViewports"],
  "properties": {
    "formatVersion": { "const": 1 }, "base": { "type": "string", "pattern": "^/(?:[A-Za-z0-9_-]+/)*$" },
    "descriptorUrl": { "type": "string", "minLength": 1 },
    "lyricPreview": {
      "type": "object", "additionalProperties": false,
      "required": ["descriptorUrl", "pageSize", "maxItems", "maxEncodedBytes", "maxDecodedBytes", "concurrentRequests"],
      "properties": {
        "descriptorUrl": { "type": "string", "pattern": "^https://[^\\s?#]+/latest\\.json$" },
        "pageSize": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "maxItems": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "maxEncodedBytes": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "maxDecodedBytes": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "concurrentRequests": { "type": "integer", "minimum": 1, "maximum": 32 }
      }
    },
    "canonicalBaseUrl": { "type": "string", "pattern": "^https://[^\\s?#]+/$" },
    "listLinkPath": { "type": "string", "pattern": "^[A-Za-z0-9_-]+/$" },
    "listFileName": { "type": "string", "pattern": "^[A-Za-z0-9_-]+\\.dvlist\\.json\\.gz$" },
    "backupFileName": { "type": "string", "pattern": "^[A-Za-z0-9_-]+\\.dvbackup\\.json\\.gz$" },
    "transferChunkBytes": { "type": "integer", "minimum": 1, "maximum": 1048576 },
    "listCompressionLevel": { "type": "integer", "minimum": 0, "maximum": 9 },
    "demoPort": { "type": "integer", "minimum": 1024, "maximum": 65535 },
    "appShell": {
      "type": "object", "additionalProperties": false,
      "required": ["workerFile", "manifestFile", "iconPrefix", "cacheId", "maxPrecacheBytes", "updateCheckIntervalMs"],
      "properties": {
        "workerFile": { "type": "string", "pattern": "^[A-Za-z0-9_-]+\\.js$" },
        "manifestFile": { "type": "string", "pattern": "^[A-Za-z0-9_-]+\\.webmanifest$" },
        "iconPrefix": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
        "cacheId": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
        "maxPrecacheBytes": { "type": "integer", "minimum": 1, "maximum": 67108864 },
        "updateCheckIntervalMs": { "type": "integer", "minimum": 1000, "maximum": 2147483647 }
      }
    },
    "databaseName": { "type": "string", "minLength": 1 },
    "fontFamily": { "type": "string", "minLength": 1 },
    "readerFontSize": { "type": "integer", "minimum": 16, "maximum": 80 },
    "readerFontSizeMin": { "type": "integer", "minimum": 16, "maximum": 80 },
    "readerFontSizeMax": { "type": "integer", "minimum": 16, "maximum": 80 },
    "readerFontSizeStep": { "type": "integer", "minimum": 1, "maximum": 64 },
    "readerLineHeights": {
      "type": "object", "required": ["compact", "normal", "relaxed"], "additionalProperties": false,
      "properties": {
        "compact": { "$ref": "#/$defs/lineHeight" },
        "normal": { "$ref": "#/$defs/lineHeight" },
        "relaxed": { "$ref": "#/$defs/lineHeight" }
      }
    },
    "space": { "type": "integer", "minimum": 1, "maximum": 32 },
    "contentWidth": { "type": "integer", "minimum": 320, "maximum": 2560 },
    "readerWidth": { "type": "integer", "minimum": 240, "maximum": 1600 },
    "themes": {
      "type": "object", "required": ["light", "dark", "warm"], "additionalProperties": false,
      "properties": { "light": { "$ref": "#/$defs/theme" }, "dark": { "$ref": "#/$defs/theme" }, "warm": { "$ref": "#/$defs/theme" } }
    },
    "demoViewports": {
      "type": "object", "required": ["desktop", "mobile"], "additionalProperties": false,
      "properties": { "desktop": { "$ref": "#/$defs/viewport" }, "mobile": { "$ref": "#/$defs/viewport" } }
    }
  },
  "$defs": {
    "lineHeight": { "type": "number", "minimum": 1.5, "maximum": 4 },
    "theme": {
      "type": "object", "required": ["background", "surface", "text", "muted", "accent", "border", "highlight"],
      "additionalProperties": false,
      "properties": {
        "background": { "$ref": "#/$defs/color" }, "surface": { "$ref": "#/$defs/color" }, "text": { "$ref": "#/$defs/color" },
        "muted": { "$ref": "#/$defs/color" }, "accent": { "$ref": "#/$defs/color" }, "border": { "$ref": "#/$defs/color" }, "highlight": { "$ref": "#/$defs/color" }
      }
    },
    "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "viewport": {
      "type": "object", "required": ["width", "height"], "additionalProperties": false,
      "properties": { "width": { "type": "integer", "minimum": 320 }, "height": { "type": "integer", "minimum": 320 } }
    }
  }
}
